      "put": {
        "tags": ["Budgets"],
        "summary": "Update budget details",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "budget_id",
            "required": true,
            "type": "integer"
          },
          {
            "in": "body",
