{
  "swagger": "2.0",
  "info": {
    "title": "Banking System API",
    "description": "API documentation for the Banking System",
    "version": "1.0.0"
  },
  "host": "banking-system-r349.onrender.com",
  "basePath": "/api",
  "schemes": ["https"],
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "JWT Authorization header using the Bearer scheme. Example: \"Authorization: Bearer {token}\""
    }
  },
  "paths": {
    "/users": {
      "post": {
        "tags": ["Users"],
        "summary": "Create a new user",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "User object",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "username",
                "email",
                "password",
                "first_name",
                "last_name"
              ],
              "properties": {
                "username": {
                  "type": "string",
                  "example": "johndoe"
                },
                "email": {
                  "type": "string",
                  "example": "john@example.com"
                },
                "password": {
                  "type": "string",
                  "example": "StrongP@ss1"
                },
                "first_name": {
                  "type": "string",
                  "example": "John"
                },
                "last_name": {
                  "type": "string",
                  "example": "Doe"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "User created successfully"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "Get current user profile",
        "security": [{ "Bearer": [] }],
        "responses": {
          "200": {
            "description": "User profile"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Update current user profile",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "User update object",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "username": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "first_name": {
                  "type": "string"
                },
                "last_name": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                },
                "current_password": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile updated successfully"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login to get access token",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Login credentials",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["username", "password"],
              "properties": {
                "username": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/refresh-token": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Refresh access token",
        "security": [{ "Bearer": [] }],
        "responses": {
          "200": {
            "description": "Token refreshed successfully"
          },
          "401": {
            "description": "Invalid refresh token"
          }
        }
      }
    },
    "/accounts": {
      "get": {
        "tags": ["Accounts"],
        "summary": "Get all accounts for current user",
        "security": [{ "Bearer": [] }],
        "responses": {
          "200": {
            "description": "List of accounts"
          }
        }
      },
      "post": {
        "tags": ["Accounts"],
        "summary": "Create a new account",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["account_type"],
              "properties": {
                "account_type": {
                  "type": "string",
                  "enum": ["savings", "checking"]
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Account created successfully"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/transactions": {
      "get": {
        "tags": ["Transactions"],
        "summary": "Get all transactions for current user",
        "security": [{ "Bearer": [] }],
        "responses": {
          "200": {
            "description": "List of transactions"
          }
        }
      },
      "post": {
        "tags": ["Transactions"],
        "summary": "Create a new transaction",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["account_id", "amount", "transaction_type"],
              "properties": {
                "account_id": {
                  "type": "integer"
                },
                "amount": {
                  "type": "string"
                },
                "transaction_type": {
                  "type": "string",
                  "enum": [
                    "deposit",
                    "withdrawal",
                    "transfer",
                    "payment",
                    "bill_payment"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "to_account_number": {
                  "type": "string"
                },
                "category_id": {
                  "type": "integer"
                },
                "bill_id": {
                  "type": "integer"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Transaction created successfully"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/bills": {
      "get": {
        "tags": ["Bills"],
        "summary": "Get all bills for current user",
        "security": [{ "Bearer": [] }],
        "responses": {
          "200": {
            "description": "List of bills"
          }
        }
      },
      "post": {
        "tags": ["Bills"],
        "summary": "Create a new bill",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "biller_name",
                "due_date",
                "amount",
                "account_id",
                "category_id"
              ],
              "properties": {
                "biller_name": {
                  "type": "string"
                },
                "due_date": {
                  "type": "string",
                  "format": "date"
                },
                "amount": {
                  "type": "string"
                },
                "account_id": {
                  "type": "integer"
                },
                "category_id": {
                  "type": "integer"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Bill created successfully"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/budgets": {
      "get": {
        "tags": ["Budgets"],
        "summary": "Get all budgets for current user",
        "security": [{ "Bearer": [] }],
        "responses": {
          "200": {
            "description": "List of budgets"
          }
        }
      },
      "post": {
        "tags": ["Budgets"],
        "summary": "Create a new budget",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name", "amount", "category_id", "duration_minutes"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "amount": {
                  "type": "string"
                },
                "category_id": {
                  "type": "integer"
                },
                "duration_minutes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Budget created successfully"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/transactions/categories": {
      "get": {
        "tags": ["Transactions"],
        "summary": "Get all transaction categories",
        "responses": {
          "200": {
            "description": "List of transaction categories"
          }
        }
      }
    },
    "/send-verification": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Send account verification email",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["username", "password"],
              "properties": {
                "username": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verification email sent successfully"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/accounts/{account_id}": {
      "get": {
        "tags": ["Accounts"],
        "summary": "Get account details by ID",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Account details"
          },
          "403": {
            "description": "Unauthorized access"
          },
          "404": {
            "description": "Account not found"
          }
        }
      },
      "put": {
        "tags": ["Accounts"],
        "summary": "Update account details",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "type": "integer"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "account_type": {
                  "type": "string",
                  "enum": ["savings", "checking"]
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account updated successfully"
          },
          "403": {
            "description": "Unauthorized access"
          },
          "404": {
            "description": "Account not found"
          }
        }
      },
      "delete": {
        "tags": ["Accounts"],
        "summary": "Delete an account",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Account deleted successfully"
          },
          "403": {
            "description": "Cannot delete main account or unauthorized access"
          },
          "404": {
            "description": "Account not found"
          }
        }
      }
    },
    "/transactions/{transaction_id}": {
      "get": {
        "tags": ["Transactions"],
        "summary": "Get transaction details by ID",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "transaction_id",
            "required": true,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction details"
          },
          "403": {
            "description": "Unauthorized access"
          },
          "404": {
            "description": "Transaction not found"
          }
        }
      }
    },
    "/bills/{bill_id}": {
      "get": {
        "tags": ["Bills"],
        "summary": "Get bill details by ID",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "bill_id",
            "required": true,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Bill details"
          },
          "403": {
            "description": "Unauthorized access"
          },
          "404": {
            "description": "Bill not found"
          }
        }
      },
      "put": {
        "tags": ["Bills"],
        "summary": "Update bill details",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "bill_id",
            "required": true,
            "type": "integer"
          },
          {
            "in": "body",
            "name": "body",
            "schema": {
              "type": "object",
              "properties": {
                "biller_name": {
                  "type": "string"
                },
                "amount": {
                  "type": "string"
                },
                "due_date": {
                  "type": "string",
                  "format": "date"
                },
                "category_id": {
                  "type": "integer"
                },
                "account_id": {
                  "type": "integer"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bill updated successfully"
          },
          "400": {
            "description": "Invalid input or cannot update paid bill"
          },
          "403": {
            "description": "Unauthorized access"
          },
          "404": {
            "description": "Bill not found"
          }
        }
      },
      "delete": {
        "tags": ["Bills"],
        "summary": "Delete a bill",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "bill_id",
            "required": true,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Bill deleted successfully"
          },
          "400": {
            "description": "Cannot delete paid bill"
          },
          "403": {
            "description": "Unauthorized access"
          },
          "404": {
            "description": "Bill not found"
          }
        }
      }
    },
    "/bills/{bill_id}/cancel": {
      "post": {
        "tags": ["Bills"],
        "summary": "Cancel a bill",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "bill_id",
            "required": true,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Bill cancelled successfully"
          },
          "400": {
            "description": "Cannot cancel paid bill or already cancelled"
          },
          "403": {
            "description": "Unauthorized access"
          },
          "404": {
            "description": "Bill not found"
          }
        }
      }
    },
    "/budgets/{budget_id}": {
      "get": {
