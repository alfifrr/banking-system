    "/activate/{token}": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Activate user account",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Account activated successfully"
          },
          "400": {
            "description": "Invalid activation token"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": ["Health"],
        "summary": "Root endpoint health check",
        "responses": {
          "200": {
            "description": "API is running"
          }
        }
      }
    },
    "/health": {
